# ── Required ──────────────────────────────────────────────────────────────────
# Financial Modeling Prep — primary data source
# Free tier: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here
# ── Optional fallback data providers ──────────────────────────────────────────
# Leave blank to run with FMP only. Set a value to activate that provider.
# See the corresponding api/*_provider.py for detailed setup notes.
#
# Alpha Vantage — documented REST API for financial statements (income / balance / cashflow).
# Free tier: 25 requests/day. Get a key at https://www.alphavantage.co/support/#api-key
# When set, AV fills financial statement fields missing from FMP (e.g. on 402 errors).
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
#
# YCharts — session token from a logged-in browser session.
# NOTE: Verify YCharts Terms of Service before use.
YCHARTS_SESSION_TOKEN=
#
# Alpha Spread — API key (future official API) or session token.
ALPHASPREAD_API_KEY=

# ── Optional — macroeconomic data ─────────────────────────────────────────────
# FRED (Federal Reserve Economic Data) — leading economic indicators.
# Free API key: https://fred.stlouisfed.org/docs/api/api_key.html
# Used by the future Macro LEI Agent for yield curve, PMI proxies, housing
# starts, jobless claims, and other macro series.
FRED_API_KEY=your_fred_api_key_here

# ── Optional — future integrations ────────────────────────────────────────────
# Finnhub — news, sentiment, earnings calendar
# https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpaca — paper/live trading execution layer
# https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ── Optional — app settings ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=stock_eval.log

EODHD_API_KEY=your_eodhd_api_key_here
